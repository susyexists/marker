# Copy this file to `local.env` and fill in your values.
#   cp local.env.example local.env
#
# `local.env` is gitignored, so your secrets stay out of version control.
# marker/settings.py loads `local.env` automatically; run_server.sh also
# loads it and passes the values to the API server.

# --- Server (read by run_server.sh) ---
HOST=0.0.0.0
PORT=8000
# GPU usage: run_server.sh launches one marker_server per GPU and load-balances
# across them. WORKERS_PER_DEVICE is the uvicorn workers PER GPU; each worker
# loads its own model copy (~5GB VRAM), so VRAM per GPU scales with it. 1 means
# one concurrent conversion per GPU — raise it if a GPU has spare memory.
WORKERS_PER_DEVICE=1
# NUM_DEVICES: how many GPUs to use. Leave unset to use all detected GPUs.
# NUM_DEVICES=3

# --- Models / device (read by marker/settings.py) ---
# cpu | cuda | mps. Leave this line COMMENTED OUT to let marker auto-detect.
# Do NOT set it empty (`TORCH_DEVICE=`): marker/surya treat the empty string as
# a literal device and crash with "Device string must not be empty". Only
# uncomment to force a specific device, e.g. `TORCH_DEVICE=cuda`.
# TORCH_DEVICE=cuda

# Note: all LLM config — service selection (llm_service), API keys, and local-LLM
# params (openai_*/ollama_*) — plus OCR options (force_ocr, etc.) are passed per
# request at the API stage, not via env, so there are no LLM/OCR vars here.

# --- Logging ---
LOGLEVEL=INFO
